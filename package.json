{
  "name": "zollpilot",
  "version": "0.0.0",
  "private": true,
  "description": "ZollPilot - Structured customs data management platform",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @zollpilot/web dev",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v",
    "prisma:generate": "pnpm --filter @zollpilot/web prisma:generate",
    "prisma:migrate": "pnpm --filter @zollpilot/web prisma:migrate",
    "prisma:seed": "pnpm --filter @zollpilot/web prisma:seed",
    "build": "pnpm --filter @zollpilot/web build",
    "start": "pnpm --filter @zollpilot/web start",
    "test": "pnpm --filter @zollpilot/web test",
    "test:unit": "pnpm --filter @zollpilot/web test",
    "test:integration": "echo 'Integration test script - TBD'",
    "test:e2e": "echo 'E2E test script - TBD'",
    "lint": "pnpm --filter @zollpilot/web lint",
    "format": "echo 'Format script - TBD'",
    "typecheck": "pnpm --filter @zollpilot/web typecheck",
    "docs:check": "echo 'Doc drift check - TBD in Phase 0.10'"
  },
  "keywords": [
    "customs",
    "zoll",
    "data-management"
  ],
  "author": "",
  "license": "UNLICENSED"
}
